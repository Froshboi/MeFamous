# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MeFamous

# ─── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google OAuth (configured in Supabase Auth providers) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Owlet SMM Provider API ───────────────────────────────────────────
# Never exposed to the client — only read inside server-side API routes.
OWLET_API_URL=https://the-owlet.com/api/v2
OWLET_API_KEY=

# ─── Scheduled jobs (Vercel Cron → /api/cron/*) ───────────────────────
# Generate any long random string; set the identical value in Vercel's
# project settings so cron requests can be verified as authentic.
CRON_SECRET=

# ─── Korapay ──────────────────────────────────────────────────────────
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
# Not used: per Korapay's docs, webhook signatures (x-korapay-signature)
# are verified with KORAPAY_SECRET_KEY itself — there's no separate
# webhook-signing secret to configure. Kept here in case that changes.
KORAPAY_WEBHOOK_SECRET=

# ─── Crypto payments (deposit addresses shown to users) ──────────────
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_ERC20_ADDRESS=
CRYPTO_LTC_ADDRESS=
CRYPTO_SOL_ADDRESS=

# ─── Email (transactional notifications) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="MeFamous <no-reply@mefamous.com>"

# ─── Support / Contact (public, rendered in footer & support pages) ──
NEXT_PUBLIC_SUPPORT_WHATSAPP=+2349018536491
NEXT_PUBLIC_SUPPORT_EMAIL=Trotskybuilds@gmail.com
